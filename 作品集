<script>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- nav scroll-spy ---- */
    var links = document.querySelectorAll('nav.rail a');
    var sections = Array.from(links).map(function (a) { return document.querySelector(a.getAttribute('href')); });
    function spy() {
      var pos = window.scrollY + window.innerHeight * 0.35, idx = 0;
      sections.forEach(function (s, i) { if (s && s.offsetTop <= pos) idx = i; });
      links.forEach(function (a, i) { a.classList.toggle('active', i === idx); });
    }

    /* ---- scroll reveal (staggered within each parent) ---- */
    var revealSel = '.sec-head, .dim-card, .edu-row, .exp-row, .cp-stats, .proj-row, .mw-row, .awards, .ph, .skill-card, footer .eyebrow, footer .big, .contact-row, .foot-line';
    var nodes = Array.from(document.querySelectorAll(revealSel));
    var groups = new Map();
    nodes.forEach(function (el) {
      el.classList.add('rv');
      var p = el.parentNode, n = (groups.get(p) || 0);
      groups.set(p, n + 1);
      el.style.setProperty('--d', Math.min(n, 8) * 70 + 'ms');
    });
    if (reduce || !('IntersectionObserver' in window)) {
      nodes.forEach(function (el) { el.classList.add('in'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      nodes.forEach(function (el) { io.observe(el); });
    }

    /* ---- parallax: hero + project thumbnails ---- */
    var heroImg = document.querySelector('.hero-media img');
    var heroInner = document.querySelector('.hero-inner');
    var hero = document.querySelector('header.hero');
    var thumbs = Array.from(document.querySelectorAll('.proj-thumb img'));
    var ticking = false;

    function frame() {
      ticking = false;
      var y = window.scrollY, vh = window.innerHeight;
      if (!reduce && hero) {
        var h = hero.offsetHeight;
        if (y < h + 40) {
          heroImg.style.transform = 'translate3d(0,' + (y * 0.32).toFixed(1) + 'px,0)';
          var t = Math.min(y / (h * 0.65), 1);
          heroInner.style.transform = 'translate3d(0,' + (y * 0.18).toFixed(1) + 'px,0)';
          heroInner.style.opacity = (1 - t * t).toFixed(3);
        }
        thumbs.forEach(function (img) {
          var r = img.parentNode.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          var p = (r.top + r.height / 2 - vh / 2) / vh;   // -0.5 .. 0.5 across viewport
          img.style.transform = 'translate3d(0,' + (p * -14).toFixed(1) + 'px,0) scale(1.12)';
        });
      }
      spy();
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    frame();
  })();
</script>
